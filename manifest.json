{
  "type": "plugin",
  "id": "org.edgeever.hotspot-tracker",
  "name": "EdgeEver 热点追踪",
  "version": "0.5.0-preview.1",
  "apiVersion": "1",
  "description": "设置关注领域与日报／周报，定期将带来源的热点汇总保存为笔记。",
  "author": "EdgeEver",
  "entry": "./main.js",
  "platforms": [
    "web",
    "desktop"
  ],
  "permissions": [
    "ai:generate",
    "network",
    "network:public",
    "notes:read",
    "notes:write",
    "metadata:read",
    "storage",
    "schedules",
    "ui:commands",
    "ui:panels",
    "ui:notices",
    "ui:navigation"
  ],
  "settings": {
    "fields": [
      {
        "key": "digest.interests",
        "type": "text",
        "label": "关注领域",
        "description": "用逗号、顿号或换行分隔，最多 5 个；留空时停止自动生成。",
        "placeholder": "例如：AI、独立开发、科技产品",
        "default": ""
      },
      {
        "key": "digest.frequency",
        "type": "select",
        "label": "生成频率",
        "description": "日报每日 09:00，周报每周一 09:00；均按设备时区执行。",
        "default": "weekly",
        "required": true,
        "options": [
          {
            "value": "daily",
            "label": "日报"
          },
          {
            "value": "weekly",
            "label": "周报"
          }
        ]
      }
    ]
  },
  "networkHosts": [
    "news.google.com",
    "hn.algolia.com",
    "api.github.com",
    "www.reddit.com"
  ]
}
